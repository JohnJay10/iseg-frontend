# Frontend Flutterwave Config - Add to .env.local

# Flutterwave Public Key (Frontend only)
# Get from: https://app.flutterwave.com/settings/keys
# This key is used to load the Flutterwave payment modal
# Test: FK_TEST_xxxxxxxxxxxxxxxxxxxxx
# Live: FK_LIVE_xxxxxxxxxxxxxxxxxxxxx
VITE_FLUTTERWAVE_PUBLIC_KEY=FK_LIVE_xxxxxxxxxxxxxxxxxxxxx

# API Base URL (Optional - defaults to http://localhost:5000 in development)
# VITE_API_URL=https://yourdomain.com/api
